{
  "name": "@posha/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/instrumentation.js ./dist/main.js",
    "start:dev": "node --import tsx --import ./src/instrumentation.ts --watch ./src/main.ts",
    "openapi:export": "tsx src/openapi-export.ts",
    "db:migrate": "node-pg-migrate up --migrations-dir ../../infra/db/migrations --database-url-var DATABASE_URL --envPath ../../.env",
    "db:rollback": "node-pg-migrate down --migrations-dir ../../infra/db/migrations --database-url-var DATABASE_URL --envPath ../../.env"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@posha/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "jose": "^6.2.13",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
