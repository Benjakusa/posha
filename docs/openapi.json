{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponseDto" }
              }
            }
          },
          "500": {
            "description": "RFC 7807 error response",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" }
              }
            }
          }
        },
        "summary": "Liveness probe",
        "tags": ["system"]
      }
    }
  },
  "info": {
    "title": "POSHA API",
    "description": "POSHA REST API contract",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "about:blank" },
          "title": { "type": "string", "example": "Not Found" },
          "status": { "type": "number", "example": 404 },
          "code": { "type": "string", "example": "NOT_FOUND" },
          "detail": {
            "type": "string",
            "example": "The request could not be processed."
          },
          "traceId": {
            "type": "string",
            "example": "0123456789abcdef0123456789abcdef"
          }
        },
        "required": ["type", "title", "status", "code", "detail", "traceId"]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "required": ["status"]
      }
    }
  }
}
