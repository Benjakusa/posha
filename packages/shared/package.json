{
  "name": "@posha/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./enums": {
      "types": "./src/enums.ts",
      "import": "./dist/enums.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./dist/errors.js"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./dist/schemas.js"
    },
    "./money": {
      "types": "./src/money.ts",
      "import": "./dist/money.js"
    }
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
